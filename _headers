# Generated by build-pages.ps1
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin

# 指纹化静态资源：文件名带内容哈希（见 build/hash-assets.mjs），
# 改版必然换 URL，因此可以安全地长缓存 + immutable。
#
# 反例（本次真实故障）：固定文件名 /assets/app.js + immutable 会让浏览器
# 永久保留改版前的脚本 —— 顶栏因此长期显示「收录 110 条」（旧版按已加载
# 条数算），修复代码早已上线也送不到那些浏览器。
# 规矩：改这条规则前先确认 assets 下的文件名是内容指纹化的。
/assets/app.8ea7f798.js
  Cache-Control: public, max-age=31536000, immutable
/assets/style.716bfb66.css
  Cache-Control: public, max-age=31536000, immutable

# 整包回滚模式的 data.js：文件名固定、内容随语料变，绝不能 immutable
/assets/data.js
  Cache-Control: public, no-cache

# 分片数据（public/shards/*）：文件名固定（boot.js / rest-general-000.js / index.js），
# 但**内容每次构建都会变**。所以绝不能 immutable —— 那会让浏览器与边缘长期
# 持有旧分片，用户看到旧语料，且极难排查（页面能开，只是内容不对）。
# 用 no-cache：可缓存，但每次必须回源校验 ETag，保证改完数据立刻生效。
/shards/*
  Cache-Control: public, no-cache

/index.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate